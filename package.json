{
  "name": "@j3pf/pi-rp",
  "version": "0.1.2",
  "description": "Pi package: connects Pi sessions to the RP relay (mobile monitoring, questions, authorizations).",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/J3pf/Rp-plugin.git"
  },
  "engines": {
    "node": ">=22.19"
  },
  "pi": {
    "extensions": [
      "./src/extension/index.ts"
    ]
  },
  "bin": {
    "rp-host": "./bin/rp-host.mjs"
  },
  "files": [
    "src",
    "dist",
    "bin",
    "docs",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --exclude test/tui-e2e.test.ts --exclude test/gentle-shell-e2e.test.ts --exclude test/rpc-e2e.test.ts",
    "test:e2e": "vitest run test/tui-e2e.test.ts test/gentle-shell-e2e.test.ts test/rpc-e2e.test.ts",
    "fixtures": "UPDATE_FIXTURES=1 vitest run test/contract.test.ts",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "proxy-agent": "^8.0.2",
    "ulid": "^3.0.2",
    "ws": "^8.22.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "gentle-pi": "^4.2.0",
    "tsx": "^4.23.15",
    "typebox": "*",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
